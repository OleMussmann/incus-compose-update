#!/usr/bin/env bash
# incus-compose-update — generic incus-compose image updater
#
# Reads per-service update metadata from the *rendered* compose definition
# (incus-compose config output) and manages pins in a tracked versions.env.
#
# Why the rendered output, not the raw compose.yaml: incus-compose
# auto-discovers and merges overlay files (e.g. a gitignored
# compose.incus.yaml in Search_Providers), so the raw base file is not what
# gets deployed. `incus-compose config` is the same binary that performs the
# deploy, so its output cannot disagree with reality. x-update: blocks
# survive the render intact; the only thing rendering destroys is the
# ${VAR} pin variable name in image:, which is interpolated away — so that
# one fact is still read from the raw file.
#
# Commands:
#   check [service]        compare pins against upstream
#   apply <service> <ref>  snapshot, pin, recreate, verify
#   apply-all [--yes]      apply every pending update, sequentially
#
# Environment:
#   STACK_DIRS    colon-separated stack directories (required, or STACK_DIR)
#   STACK_DIR     single-stack directory (alternative to STACK_DIRS)
#   INCUS_POOL    storage pool (default: local)
#   INCUS_PROJECT incus project (default: detected from rendered config)

set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
usage:
  incus-compose-update check                  compare pinned tags against upstream, all services
  incus-compose-update check <service>        same, scoped to one service
  incus-compose-update apply <service> <ref>  snapshot, pin, recreate, verify
  incus-compose-update apply-all [--yes]      apply every pending update, one at a time
  incus-compose-update --help                 this text

config (environment):
  STACK_DIRS    colon-separated stack directories (required, or STACK_DIR)
  STACK_DIR     single-stack directory (alternative to STACK_DIRS)
  INCUS_POOL    storage pool (default: local)
  INCUS_PROJECT incus project (default: detected from rendered config)
EOF
}

# --help/-h must work without STACK_DIRS set
case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac

POOL="${INCUS_POOL:-local}"
READY_TRIES="${READY_TRIES:-20}"
READY_INTERVAL="${READY_INTERVAL:-3}"

# --- stack directory resolution ---

resolve_stack_dirs() {
  if [[ -n "${STACK_DIRS:-}" ]]; then
    IFS=':' read -ra dirs <<< "$STACK_DIRS"
    printf '%s\n' "${dirs[@]}"
  elif [[ -n "${STACK_DIR:-}" ]]; then
    echo "$STACK_DIR"
  else
    die "set STACK_DIRS (colon-separated) or STACK_DIR"
  fi
}

# --- rendered compose access ---
#
# RENDERED is a path to the output of `incus-compose config` for the current
# stack dir. Both .env and versions.env are passed so variables resolve
# exactly as they will at deploy time; versions.env is touched on demand
# (incus-compose errors if a listed env file is missing).
#
# --env-file REPLACES the default .env: passing it once means .env is no
# longer read unless also listed, so both must always be passed, pins last.

incus_compose() {
  local stack_dir="$1"; shift
  ( cd "$stack_dir" && incus-compose --env-file .env --env-file versions.env "$@" )
}

render_stack() {
  local stack_dir="$1"
  local env_file="$stack_dir/versions.env"
  [[ -f "$env_file" ]] || touch "$env_file"
  RENDERED=$(mktemp)
  # stderr carries "variable is not set" warnings — suppress, they confuse yq
  incus_compose "$stack_dir" config 2>/dev/null > "$RENDERED" \
    || die "incus-compose config failed in ${stack_dir}"
  # incus-compose 1.1.0 wrapped the render in a top-level `project:` key;
  # 1.2.0 emits name:/services: at the root instead. Unwrap the old shape so
  # every query below can assume the flat one. Hit live 2026-08-19: after the
  # 1.2.0 upgrade every .project.* path resolved to null and check died with
  # "cannot get keys of !!null".
  if yq -e '.project' "$RENDERED" >/dev/null 2>&1; then
    yq -i '.project' "$RENDERED"
  fi
}

cleanup_render() {
  [[ -n "${RENDERED:-}" ]] && rm -f "$RENDERED"
}

# --- image reference parsing ---

# Parse image reference into HOST, REPO and TAG globals.
#
# Order matters: strip the digest, then the tag, and only then split off the
# host. The previous version cut at the FIRST ':' to get the bare name, which
# silently destroyed two things:
#
#   1. The tag. Digest mode then asked the registry for a hardcoded `latest`
#      no matter what the ref said, so Hermes' buzz-cli-sync
#      (`docker.io/debian:13-slim@${DEBIAN_DIGEST}`) was handed the digest of
#      debian:latest — the full, non-slim image. The ref still read 13-slim
#      while resolving to something else. Hit live 2026-08-29.
#
#   2. A registry port. `registry.local:5000/team/app` became the bare name
#      `registry.local`, which then parsed as the Docker Hub official image
#      `library/registry.local`. The `*:*` test below was already written to
#      recognise a ported host, but could never fire, because the port had
#      been cut off two lines earlier.
parse_image_ref() {
  local ref="$1"

  # Digest first — everything after '@' is opaque.
  local name="${ref%%@*}"

  # Then the tag: the part after the LAST ':', but only when it holds no '/'.
  # In `host:5000/repo` that colon introduces a port, not a tag. A ref with no
  # tag means `latest`, same as any registry client.
  TAG="latest"
  local last="${name##*:}"
  if [[ "$name" == *:* && "$last" != */* ]]; then
    TAG="$last"
    name="${name%:*}"
  fi

  # What is left is the name. Its first path segment is a registry host when
  # it looks like one: a dot (registry.example.com), a port (registry:5000),
  # or literally localhost. Anything else is a Docker Hub namespace.
  local first="${name%%/*}"
  if [[ "$name" == */* && ( "$first" == *.* || "$first" == *:* || "$first" == "localhost" ) ]]; then
    HOST="$first"
    REPO="${name#*/}"
  else
    HOST="docker.io"
    REPO="$name"
  fi

  # docker.io namespaces single-segment official images under library/
  if [[ "$HOST" == "docker.io" && "$REPO" != */* ]]; then
    REPO="library/${REPO}"
  fi
}

# --- x-update: parsing ---
#
# Reads x-update metadata from the rendered config (RENDERED) and the pin
# variable name from the raw compose.yaml (rendering interpolates ${VAR}
# away). Sets globals: MODE, TAG_RE, ORDER, VOLUME, VERSION_CMD, IMAGE,
# PIN_VAR, HOST, REPO, TAG.

pin_var_from_raw() {
  local raw_compose="$1" service="$2"
  # Raw compose.yaml may use merge anchors (<<: *common-service). yq-go warns
  # about that by default; --yaml-fix-merge-anchor-to-spec silences it.
  yq --yaml-fix-merge-anchor-to-spec -r ".services.\"${service}\".image" "$raw_compose" \
    | grep -oP '\$\{[^}]+\}' | head -1 | sed 's/\${//;s/}//' || true
}

parse_x_update() {
  local stack_dir="$1" service="$2"
  local rendered="$3"
  local raw_compose="$stack_dir/compose.yaml"

  # Check if service has x-update: block in the rendered definition
  yq -e ".services.\"${service}\".x-update" "$rendered" >/dev/null 2>&1 \
    || die "service '${service}' has no x-update: block"

  MODE=$(yq -r ".services.\"${service}\".x-update.mode // \"tag\"" "$rendered")
  TAG_RE=$(yq -r ".services.\"${service}\".x-update.tag_re // \"\"" "$rendered")
  ORDER=$(yq -r ".services.\"${service}\".x-update.order // \"version\"" "$rendered")
  VOLUME=$(yq -r ".services.\"${service}\".x-update.volume // \"none\"" "$rendered")

  # version_cmd: argv list → space-separated → bash array
  local version_cmd_raw
  version_cmd_raw=$(
    yq -r "((.services.\"${service}\".x-update.version_cmd) // [\"${service}\", \"--version\"]) | .[]" "$rendered" 2>/dev/null
  )
  read -ra VERSION_CMD <<< "$(echo "$version_cmd_raw" | paste -sd ' ' -)"

  # Resolved image reference (tag/digest already interpolated by the render)
  IMAGE=$(yq -r ".services.\"${service}\".image" "$rendered")

  # Pin variable name comes from the RAW file only
  PIN_VAR=$(pin_var_from_raw "$raw_compose" "$service")
  [[ -n "$PIN_VAR" ]] || die "cannot detect pin variable in raw compose image: $(yq -r ".services.\"${service}\".image" "$raw_compose")"

  parse_image_ref "$IMAGE"
}

# --- registry access ---

fetch_tags_dockerhub() {
  local repo="$1"
  curl -fsSL "https://hub.docker.com/v2/repositories/${repo}/tags?page_size=100&ordering=last_updated" \
    | jq -r '.results[].name'
}

fetch_tags_oci() {
  local host="$1" repo="$2"
  local token url tags link tmpbody tmpheaders

  token=$(curl -fsSL "https://${host}/token?scope=repository:${repo}:pull" | jq -r .token)
  [[ -n "$token" && "$token" != "null" ]] || die "could not get token for ${host}/${repo}"

  url="https://${host}/v2/${repo}/tags/list?n=100"
  tags=""

  while [[ -n "$url" ]]; do
    tmpbody=$(mktemp)
    tmpheaders=$(mktemp)

    curl -fsSL -D "$tmpheaders" -H "Authorization: Bearer $token" "$url" > "$tmpbody"

    local page_tags
    page_tags=$(jq -r '.tags // [] | .[]' "$tmpbody")
    tags="${tags}${page_tags}"$'\n'

    # Follow Link header to exhaustion — one unpaginated GHCR page yields a
    # stale newest (firecrawl 2.10.19 vs the real 2.11.182 over 9 pages)
    link=$(grep -i '^link:' "$tmpheaders" | grep -oP '<[^>]+>' | tr -d '<>' | head -1)
    rm -f "$tmpbody" "$tmpheaders"

    if [[ -n "$link" ]]; then
      [[ "$link" == /* ]] && link="https://${host}${link}"
      url="$link"
    else
      url=""
    fi
  done

  echo "$tags" | grep -v '^$' | sort -u
}

fetch_digest() {
  local host="$1" repo="$2" tag="$3"
  local token reg_host
  if [[ "$host" == "docker.io" ]]; then
    # Docker Hub: separate auth service, registry on registry-1. The /token
    # endpoint (used by ghcr.io and friends) does not exist on docker.io.
    token=$(curl -fsSL "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repo}:pull" | jq -r .token)
    reg_host="registry-1.docker.io"
  else
    token=$(curl -fsSL "https://${host}/token?scope=repository:${repo}:pull" | jq -r .token)
    reg_host="$host"
  fi
  curl -fsSL -o /dev/null -D - -I \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.oci.image.index.v1+json" \
    -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" \
    -H "Accept: application/vnd.oci.image.manifest.v1+json" \
    -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
    "https://${reg_host}/v2/${repo}/manifests/${tag}" \
    | grep -i '^docker-content-digest:' \
    | awk '{print $2}' \
    | tr -d '\r'
}

# --- tag selection ---

newest_tag() {
  local tags="$1" tag_re="$2" order="$3"
  local filtered
  filtered=$(echo "$tags" | { grep -E "$tag_re" || true; })
  [[ -n "$filtered" ]] || return 1

  if [[ "$order" == "pushed" ]]; then
    echo "$filtered" | head -1
  else
    echo "$filtered" | sort -V | tail -1
  fi
}

# --- backwards guard ---

version_gte() {
  printf '%s\n%s' "$2" "$1" | sort -V -C
}

# --- pin file operations ---

current_pin() {
  grep -E "^${2}=" "$1" 2>/dev/null | head -1 | cut -d= -f2- || true
}

write_pin() {
  local env_file="$1" pin_var="$2" value="$3"
  if grep -qE "^${pin_var}=" "$env_file" 2>/dev/null; then
    sed -i "s|^${pin_var}=.*|${pin_var}=${value}|" "$env_file"
  else
    echo "${pin_var}=${value}" >> "$env_file"
  fi
}

# --- incus operations ---

detect_project() {
  # From the rendered config, not the raw file: overlays can set name:
  yq -r '.name // ""' "$1" 2>/dev/null | head -1
}

preflight() {
  local project="$1" volume="$2"
  [[ "$volume" == "none" ]] && return 0
  if ! incus --project "$project" storage volume show "$POOL" "$volume" >/dev/null 2>&1; then
    echo "cannot find volume '${volume}' on pool '${POOL}' in project '${project}'" >&2
    incus --project "$project" storage volume list "$POOL" >&2 || true
    die "set INCUS_POOL or x-update.volume to match"
  fi
}

version_of() {
  local stack_dir="$1" service="$2"
  shift 2
  # exec DOES parse compose.yaml (to find the instance), so both env files
  # must be supplied or interpolated ${VAR}s render blank and the command
  # fails before ever reaching the container.
  ( cd "$stack_dir" && incus-compose --env-file .env --env-file versions.env exec "$service" -- "$@" 2>/dev/null ) || true
}

# What image the instance was actually created from — the authoritative answer
# to "was it recreated on the new pin", and the thing a version string only
# ever approximated.
#
# Two keys carry it, and either alone settles it, so a match on either passes
# and the check survives one of them changing shape:
#   image.id          set by Incus from the OCI descriptor, host-less:
#                     searxng/searxng:2026.8.28-a30b2d474
#                     library/debian@sha256:d7e12182...
#   user.image_alias  stamped by incus-compose, host-qualified:
#                     docker.io/searxng/searxng:2026.8.28-a30b2d474
# Verified against all six instances across docker.io and ghcr.io on
# incus 7.3.0 / incus-compose 1.2.0.
instance_image_id() {
  incus --project "$1" config get "$2" image.id 2>/dev/null || true
}

instance_image_alias() {
  incus --project "$1" config get "$2" user.image_alias 2>/dev/null || true
}

# A pin is either a digest (sha256:...) or a tag, and the ref joins them with
# '@' or ':' respectively.
ref_separator() {
  [[ "$1" == sha256:* ]] && echo "@" || echo ":"
}

# --- upstream resolution ---

# Newest upstream ref for the service described by the globals parse_x_update
# just set (MODE, TAG_RE, ORDER, HOST, REPO). Echoes the ref; dies on an
# unreachable registry, a tag_re that no longer matches, or a result that
# sorts older than the current pin. Shared by check and apply-all so the two
# can never disagree about what "latest" means.
resolve_latest() {
  local service="$1" cur="$2"

  if [[ "$MODE" == "digest" ]]; then
    # The tag from the image ref, not a hardcoded `latest` — see parse_image_ref.
    fetch_digest "$HOST" "$REPO" "$TAG" \
      || die "could not fetch digest for ${REPO}:${TAG}"
    return 0
  fi

  local tags new
  if [[ "$HOST" == "docker.io" ]]; then
    tags=$(fetch_tags_dockerhub "$REPO") || die "could not reach Docker Hub for ${REPO}"
  else
    tags=$(fetch_tags_oci "$HOST" "$REPO") || die "could not reach ${HOST} for ${REPO}"
  fi

  new=$(newest_tag "$tags" "$TAG_RE" "$ORDER") || {
    echo "no tags matched ${TAG_RE}" >&2
    echo "upstream may have changed its versioning scheme. Saw:" >&2
    printf '%s\n' "$tags" | head -8 | sed 's/^/  /' >&2
    die "update tag_re for ${service} in compose.yaml"
  }

  # Never move backwards: a computed-newest that sorts older than the pin
  # is truncation (pagination bug) or a scheme change — make it loud.
  #
  # But compare only the dotted-numeric core for order: pushed. Those tags
  # carry an opaque build suffix (searxng: 2026.8.28-a30b2d474), and GNU
  # sort -V compares the leading DIGIT RUN of that suffix numerically:
  # "9fea41204" reads as 9, "777ba8fa4" as 777, so 2026.8.22-9fea41204 sorts
  # BELOW 2026.8.22-777ba8fa4. Two builds of the same day therefore order
  # arbitrarily and the guard fires on a perfectly good update. Push time is
  # the authority for these anyway — version sort explicitly is not.
  # Equal cores are same-day rebuilds and legitimately move forward; a truly
  # older core (2026.8.28 -> 2026.7.1) still dies. Hit live 2026-08-29:
  # searxng publishes twice a day routinely, making this a coin flip.
  local guard_new="$new" guard_cur="$cur"
  if [[ "$ORDER" == "pushed" ]]; then
    guard_new="${new%%-*}"
    guard_cur="${cur%%-*}"
  fi
  if [[ "$guard_cur" != "$guard_new" ]] && ! version_gte "$guard_new" "$guard_cur"; then
    die "upstream newest (${new}) is older than current pin (${cur}) — upstream list looks truncated or the tag scheme changed"
  fi

  echo "$new"
}

# --- commands ---

cmd_check_one() {
  local stack_dir="$1" service="$2"
  local env_file="$stack_dir/versions.env"

  parse_x_update "$stack_dir" "$service" "$RENDERED"

  local cur
  cur=$(current_pin "$env_file" "$PIN_VAR")
  if [[ -z "$cur" ]]; then
    echo "== ${service}: no ${PIN_VAR} in ${env_file} — skipping"
    return 0
  fi

  echo "== ${service}"

  local new
  new=$(resolve_latest "$service" "$cur")

  printf 'current: %s\nlatest:  %s\n' "$cur" "$new"
  if [[ "$cur" == "$new" ]]; then
    echo "up to date"
  else
    printf 'apply:     incus-compose-update apply %s %s\n' "$service" "$new"
  fi
  echo
}

cmd_check() {
  local service="${1:-}"

  if [[ -n "$service" ]]; then
    local found=0
    while IFS= read -r dir; do
      [[ -f "$dir/compose.yaml" ]] || continue
      render_stack "$dir"
      if yq -e ".services.\"${service}\"" "$RENDERED" >/dev/null 2>&1; then
        cmd_check_one "$dir" "$service"
        found=1
        cleanup_render
        break
      fi
      cleanup_render
    done < <(resolve_stack_dirs)
    [[ $found -eq 1 ]] || die "service '${service}' not found in any stack dir"
  else
    # NOTE: not isolated per stack — resolve_latest dies on an unreachable
    # registry or a stale tag_re, and die exits, so the stacks after it are
    # never reached. Scope a run with `check <service>` when one is broken.
    while IFS= read -r dir; do
      [[ -f "$dir/compose.yaml" ]] || continue
      echo "== stack: ${dir}"
      render_stack "$dir"
      local services
      services=$(yq -r '.services | keys[]' "$RENDERED")
      for svc in $services; do
        yq -e ".services.\"${svc}\".x-update" "$RENDERED" >/dev/null 2>&1 || continue
        cmd_check_one "$dir" "$svc"
      done
      cleanup_render
    done < <(resolve_stack_dirs)
  fi
}

cmd_apply() {
  local service="${1:-}" ref="${2:-}"
  [[ -n "$service" && -n "$ref" ]] || die "usage: incus-compose-update apply <service> <ref>"

  # Find stack dir containing this service
  local stack_dir=""
  while IFS= read -r dir; do
    [[ -f "$dir/compose.yaml" ]] || continue
    render_stack "$dir"
    if yq -e ".services.\"${service}\"" "$RENDERED" >/dev/null 2>&1; then
      stack_dir="$dir"
      break
    fi
    cleanup_render
  done < <(resolve_stack_dirs)
  [[ -n "$stack_dir" ]] || die "service '${service}' not found in any stack dir"

  local env_file="$stack_dir/versions.env"
  [[ -f "$env_file" ]] || touch "$env_file"

  parse_x_update "$stack_dir" "$service" "$RENDERED"

  local cur
  cur=$(current_pin "$env_file" "$PIN_VAR")
  [[ -n "$cur" ]] || die "no ${PIN_VAR} in ${env_file}"
  [[ "$cur" == "$ref" ]] && { echo "already on $ref"; return 0; }

  local project
  project=$(detect_project "$RENDERED")
  project="${INCUS_PROJECT:-$project}"

  preflight "$project" "$VOLUME"

  local before
  before=$(version_of "$stack_dir" "$service" "${VERSION_CMD[@]}")

  # Snapshot
  local snap=""
  if [[ "$VOLUME" != "none" ]]; then
    snap="pre-${ref}-$(date +%Y%m%d%H%M)"
    echo "==> snapshotting ${project}:${POOL}/${VOLUME} as ${snap}"
    # --no-expiry: a rollback point has to outlive the volume's own retention.
    # Without it the server fills the expiry from snapshots.expiry.manual,
    # falling back to snapshots.expiry, so a volume on a daily schedule would
    # prune its pre-upgrade snapshots along with the scheduled ones.
    incus --project "$project" storage volume snapshot create --no-expiry "$POOL" "$VOLUME" "$snap"
  fi

  # Pin
  echo "==> pinning ${cur} -> ${ref}"
  write_pin "$env_file" "$PIN_VAR" "$ref"

  # Recreate — both env files, pins last
  echo "==> pulling and recreating"
  incus_compose "$stack_dir" up -d --recreate --pull always "$service"

  # A service-scoped `up` under incus-compose 1.2.0 can create the instance
  # correctly and then leave it STOPPED: its "Starting resources" phase walks
  # the whole project graph and bails on any resource this run did not ensure,
  # including sibling services' images. Hit live 2026-08-19 updating hermes in
  # a two-service stack — "resource not ensured:
  # image(docker.io/syncthing/syncthing:2.1.3)", buried mid-stream, instance
  # built with the right image and volumes but never booted.
  #
  # `start` walks a much smaller graph and gets it up. On an already-running
  # service it declines with "resource is already running" and leaves the
  # process untouched, so this is a no-op on the happy path — hence the
  # swallowed output. A start that genuinely fails still surfaces, as the
  # readiness check below will not see the instance come back.
  incus_compose "$stack_dir" start "$service" >/dev/null 2>&1 || true

  # --- verify ---
  #
  # Two independent facts, checked separately because neither implies the
  # other: the instance was rebuilt on the new ref, and it came back up.
  #
  # This used to be inferred from a single signal — "the version string
  # changed" — which cannot work for a digest-pinned base image. Two rebuilds
  # of debian:13-slim are both Debian 13.6, so buzz-cli-sync's
  # `cat /etc/debian_version` reads 13.6 on both sides of a perfectly good
  # update. apply then declared failure and suggested a rollback that failed
  # identically, for the same reason, in the other direction. Hit live
  # 2026-08-29. Image identity is the fact that actually answers the question;
  # the probe now only has to show the container is alive.
  local instance="${service}-1"

  echo "==> waiting for readiness"
  local after="" ready=0
  for _ in $(seq 1 "$READY_TRIES"); do
    sleep "$READY_INTERVAL"
    after=$(version_of "$stack_dir" "$service" "${VERSION_CMD[@]}")
    if [[ -n "$after" ]]; then ready=1; break; fi
    printf '.'
  done
  echo

  incus_compose "$stack_dir" ps

  local sep want_id want_alias got_id got_alias
  sep=$(ref_separator "$ref")
  want_id="${REPO}${sep}${ref}"
  want_alias="${HOST}/${REPO}${sep}${ref}"
  got_id=$(instance_image_id "$project" "$instance")
  got_alias=$(instance_image_alias "$project" "$instance")

  if [[ -z "$got_id" && -z "$got_alias" ]]; then
    echo
    echo "!! cannot read image identity of ${project}:${instance}"
    echo "   expected image.id: ${want_id}"
    echo "   neither image.id nor user.image_alias is set — wrong instance name,"
    echo "   or this Incus/incus-compose no longer records it."
    echo "   inspect:    incus --project ${project} config show ${instance}"
    echo "   roll back:  incus-compose-update apply ${service} ${cur}"
    [[ -n "$snap" ]] && echo "   or restore: incus --project ${project} storage volume restore ${POOL} ${VOLUME} ${snap}"
    return 1
  fi

  if [[ "$got_id" != "$want_id" && "$got_alias" != "$want_alias" ]]; then
    echo
    echo "!! ${instance} is not running the new image"
    echo "   wanted: ${want_id}"
    echo "   got:    ${got_id:-${got_alias}}"
    echo "   the recreate did not take — the instance still holds its old image."
    echo "   logs:       incus --project ${project} console ${instance} --show-log"
    echo "   roll back:  incus-compose-update apply ${service} ${cur}"
    [[ -n "$snap" ]] && echo "   or restore: incus --project ${project} storage volume restore ${POOL} ${VOLUME} ${snap}"
    # return, not exit: apply-all catches this to stop the run cleanly. The
    # dispatcher turns a non-zero return back into a non-zero exit status.
    return 1
  fi

  if [[ $ready -eq 0 ]]; then
    echo
    echo "!! ${instance} is on the new image but did not respond in $((READY_TRIES * READY_INTERVAL))s"
    echo "   image:  ${want_id}"
    echo "   probe:  ${VERSION_CMD[*]}"
    echo "   it produced no output — the container may still be booting, may be"
    echo "   crash-looping, or the probe itself may be wrong for this image."
    echo "   logs:       incus --project ${project} console ${instance} --show-log"
    echo "   roll back:  incus-compose-update apply ${service} ${cur}"
    [[ -n "$snap" ]] && echo "   or restore: incus --project ${project} storage volume restore ${POOL} ${VOLUME} ${snap}"
    return 1
  fi

  echo "==> verified ${want_id}"
  # An unchanged version string is normal for a digest-pinned base image and
  # no longer means anything is wrong — report it, do not judge it.
  if [[ "$after" == "$before" ]]; then
    echo "    ${after} (unchanged — rebuild of the same release)"
  else
    echo "    ${before:-<none>}"
    echo " -> ${after}"
  fi

  # Commit but never push. Auto-pushing adds auth prompts, rejected pushes
  # and branch-protection failures to a run that just succeeded. Unpushed
  # pins drift between machines though — say so rather than stay silent.
  if git -C "$stack_dir" commit -q -m "${service}: ${cur} -> ${ref}" -- "$env_file" 2>/dev/null; then
    echo "==> pinned and committed (not pushed)"
    if git -C "$stack_dir" remote | grep -q .; then
      echo "    push when ready: git -C ${stack_dir} push"
    fi
  else
    echo "==> pinned (not committed — no repo, or nothing to commit)"
  fi

  echo "==> done. rollback: incus-compose-update apply ${service} ${cur}"
}

# apply-all is deliberately sequential, never concurrent. Four things in this
# script are not safe to run in parallel within a stack:
#   - write_pin sed -i's a versions.env shared by every service in the stack
#   - each apply ends in `git commit -- versions.env`, which collides on
#     .git/index.lock and can capture a peer's half-written pin
#   - `up --recreate <svc>` starts linked services (no --no-deps), so two
#     recreates fight over shared dependency containers
#   - verification exec's into the container; a peer restarting a shared
#     dependency mid-check reads as a failed update
# Little is lost by serialising: incus-compose already funnels image pulls
# through vol-ic-image-lock in its cache project. Sequential also means a
# failure has exactly one suspect.

cmd_apply_all() {
  local assume_yes="${1:-0}"

  # --- plan ---
  #
  # Every target ref is resolved before anything is mutated: an unreachable
  # registry or a stale tag_re must fail here, with all stacks still on their
  # current pins, rather than halfway through a run.
  local plan=()
  local dir svc cur new services
  while IFS= read -r dir; do
    [[ -f "$dir/compose.yaml" ]] || continue
    render_stack "$dir"
    services=$(yq -r '.services | keys[]' "$RENDERED")
    for svc in $services; do
      yq -e ".services.\"${svc}\".x-update" "$RENDERED" >/dev/null 2>&1 || continue
      parse_x_update "$dir" "$svc" "$RENDERED"
      cur=$(current_pin "$dir/versions.env" "$PIN_VAR")
      # No pin to move: same "skipping" case check reports, silent here.
      [[ -n "$cur" ]] || continue
      new=$(resolve_latest "$svc" "$cur")
      [[ "$cur" == "$new" ]] && continue
      plan+=("${dir}"$'\t'"${svc}"$'\t'"${cur}"$'\t'"${new}")
    done
    cleanup_render
  done < <(resolve_stack_dirs)

  if [[ ${#plan[@]} -eq 0 ]]; then
    echo "everything is up to date"
    return 0
  fi

  # --- show the plan ---
  local entry last_dir=""
  echo "planned updates:"
  for entry in "${plan[@]}"; do
    IFS=$'\t' read -r dir svc cur new <<< "$entry"
    if [[ "$dir" != "$last_dir" ]]; then
      echo
      echo "  stack: ${dir}"
      last_dir="$dir"
    fi
    printf '    %-22s %s -> %s\n' "$svc" "$cur" "$new"
  done
  echo

  # --- confirm ---
  if [[ "$assume_yes" != "1" ]]; then
    if [[ ! -t 0 ]]; then
      die "apply-all needs a terminal to confirm — pass --yes for unattended runs"
    fi
    local reply
    read -r -p "recreate ${#plan[@]} service(s), one at a time? [y/N] " reply
    case "$reply" in
      y|Y|yes|YES) ;;
      *) echo "aborted — nothing was changed"; return 0 ;;
    esac
    echo
  fi

  # --- apply, one at a time ---
  #
  # cmd_apply re-renders and re-reads the pin for itself rather than trusting
  # the plan: the pin it writes is the one it just read, so a stale plan can
  # never cause a wrong pin to be committed.
  local n=0 total=${#plan[@]}
  for entry in "${plan[@]}"; do
    IFS=$'\t' read -r dir svc cur new <<< "$entry"
    echo "=================================================================="
    echo "[$((n + 1))/${total}] ${svc}: ${cur} -> ${new}"
    echo "=================================================================="
    if ! cmd_apply "$svc" "$new"; then
      echo
      echo "!! stopped at ${svc} — ${n} of ${total} applied"
      echo "   the remaining $((total - n - 1)) service(s) are untouched and still"
      echo "   on their current pins. Fix this one, then re-run apply-all."
      return 1
    fi
    n=$((n + 1))
    echo
  done

  echo "applied ${n} update(s)"
}

# --- main ---

case "${1:-check}" in
  check)      shift; cmd_check "${1:-}" ;;
  apply)      shift; cmd_apply "${1:-}" "${2:-}" || exit 1 ;;
  apply-all)
    shift
    ASSUME_YES=0
    case "${1:-}" in
      --yes|-y) ASSUME_YES=1 ;;
      "")       ;;
      *)        die "unknown option for apply-all: $1" ;;
    esac
    cmd_apply_all "$ASSUME_YES" || exit 1
    ;;
  *)          die "usage: incus-compose-update {check [service] | apply <service> <ref> | apply-all [--yes]}" ;;
esac
